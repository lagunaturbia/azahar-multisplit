+extern "C" RETRO_API bool azahar_multisplit_init_local() {
+    if (!multisplit_network_initialized)
+        multisplit_network_initialized = Network::Init();
+    return multisplit_network_initialized;
+}
+
+extern "C" RETRO_API void azahar_multisplit_set_equal_screens(bool enabled) {
+    EmuWindow_LibRetro::SetMultisplitEqualScreens(enabled);
+    if (emu_instance->emu_window)
+        emu_instance->emu_window->UpdateLayout();
+}
+
+extern "C" RETRO_API uint16_t azahar_multisplit_host_local(unsigned players) {
+    if (players < 2 || players > 4)
+        return 0;
+    auto room = Network::GetRoom().lock();
+    if (!room)
+        return 0;
+    if (room->GetState() == Network::Room::State::Open)
+        return room->GetRoomInformation().port;
+    if (!room->Create("Azahar Multisplit", "", "127.0.0.1", 0, "", players, "Player 1", "", 0,
+                      std::make_unique<Network::VerifyUser::NullBackend>(), {}))
+        return 0;
+    return room->GetRoomInformation().port;
+}
+
+extern "C" RETRO_API bool azahar_multisplit_join_local(uint16_t port, unsigned player) {
+    auto& system = Core::System::GetInstance();
+    auto member = Network::GetRoomMember().lock();
+    if (!system.IsPoweredOn() || !member || port == 0 || player >= 4)
+        return false;
+
+    const std::string suffix = std::to_string(player + 1);
+    member->Join("Player " + suffix, "multisplit-player-" + suffix, "127.0.0.1", port, 0,
+                 Network::NoPreferredMac, "", "");
+    using namespace std::chrono_literals;
+    const auto deadline = std::chrono::steady_clock::now() + 2s;
+    using State = Network::RoomMember::State;
+    while (member->GetState() == State::Joining &&
+           std::chrono::steady_clock::now() < deadline)
+        std::this_thread::sleep_for(5ms);
+    const auto state = member->GetState();
+    if (state != State::Joined && state != State::Moderator)
+        return false;
+    system.Kernel().GetSharedPageHandler().SetMacAddress(member->GetMacAddress());
+    return true;
+}
+
+static void LeaveMultisplitRoom() {
+    if (auto member = Network::GetRoomMember().lock(); member && member->IsConnected())
+        member->Leave();
+}
 
