+
+class FragmentCompiler {
+public:
+    explicit FragmentCompiler(FragmentCompilerContext callbacks_) : callbacks(callbacks_) {}
+
+    bool Start() {
+        context = callbacks.create();
+        if (!context)
+            return false;
+        std::promise<bool> started;
+        auto ready = started.get_future();
+        thread = std::thread([this, result = std::move(started)]() mutable {
+            const bool current = callbacks.make_current(context);
+            result.set_value(current);
+            if (!current)
+                return;
+            for (;;) {
+                std::packaged_task<OGLShaderStage()> compile;
+                {
+                    std::unique_lock lock(mutex);
+                    wake.wait(lock, [&] { return stopping || !queue.empty(); });
+                    if (stopping)
+                        break;
+                    compile = std::move(queue.front());
+                    queue.pop_front();
+                }
+                compile();
+            }
+            callbacks.clear_current(context);
+        });
+        return ready.get();
+    }
+
+    std::future<OGLShaderStage> Queue(std::string source, bool separable) {
+        const bool first = !submitted_shader;
+        submitted_shader = true;
+        std::packaged_task<OGLShaderStage()> compile([code = std::move(source), separable, first] {
+            OGLShaderStage stage(separable);
+            stage.Create(code.c_str(), GL_FRAGMENT_SHADER);
+            // Only the compilation thread waits here. Publish a usable shared GL object.
+            glFinish();
+            if (first)
+                LOG_INFO(Render_OpenGL, "First fragment shader compiled on the background thread");
+            return stage;
+        });
+        auto result = compile.get_future();
+        {
+            std::lock_guard lock(mutex);
+            queue.push_back(std::move(compile));
+        }
+        wake.notify_one();
+        return result;
+    }
+
+    ~FragmentCompiler() {
+        {
+            std::lock_guard lock(mutex);
+            stopping = true;
+            queue.clear();
+        }
+        wake.notify_one();
+        if (thread.joinable())
+            thread.join();
+        if (context)
+            callbacks.destroy(context);
+    }
+
+private:
+    FragmentCompilerContext callbacks;
+    void* context{};
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::deque<std::packaged_task<OGLShaderStage()>> queue;
+    bool stopping{};
+    bool submitted_shader{};
+    std::thread thread;
+};
